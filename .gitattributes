# Keep the repo LF-clean: deploy/build.sh and the Dockerfile run inside Linux
# containers, and a stray CRLF there turns into "bad interpreter" at build time.
* text=auto eol=lf

*.sh    text eol=lf
Dockerfile text eol=lf

*.png   binary
*.jpg   binary
*.webp  binary
*.heic  binary
*.HEIC  binary
*.dng   binary
*.MOV   binary
*.svg   text eol=lf
